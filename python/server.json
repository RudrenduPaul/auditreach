{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.RudrenduPaul/auditreach",
  "description": "BYOK Reddit/YouTube research CLI with a tamper-evident audit log and an MCP server.",
  "repository": {
    "url": "https://github.com/RudrenduPaul/auditreach",
    "source": "github"
  },
  "version": "0.2.5",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "auditreach-cli",
      "version": "0.2.5",
      "runtimeHint": "uvx",
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--from",
          "value": "auditreach-cli"
        }
      ],
      "packageArguments": [
        {
          "type": "positional",
          "valueHint": "script_name",
          "value": "auditreach"
        },
        {
          "type": "positional",
          "valueHint": "subcommand",
          "value": "mcp"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
